[rhel-9-golang-rpms-x86_64]
baseurl = https://ocp-artifacts.engineering.redhat.com/pub/RHOCP/plashets/4.16/stream/golang-el9/latest/x86_64/os/
module_hotfixes = 1
includepkgs = module-build-macros golang* goversioninfo
name = rhel-9-golang-rpms-x86_64
gpgcheck = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
sslcacert = /tmp/art/Current-IT-Root-CAs.pem

